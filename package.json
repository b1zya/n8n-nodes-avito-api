{
  "name": "n8n-nodes-avito-api",
  "version": "3.0.1",
  "description": "n8n node для интеграции с API Авито для бизнеса",
  "keywords": [
    "n8n-community-node-package",
    "avito",
    "api",
    "oauth2",
    "promotion",
    "cpxpromo",
    "ads",
    "analytics"
  ],
  "license": "MIT",
  "homepage": "https://github.com/b1zya/n8n-nodes-avito-api",
  "author": {
    "name": "Max",
    "email": "max.gorshunov@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b1zya/n8n-nodes-avito-api.git"
  },
  "engines": {
    "node": ">=22.22"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "n8n-node dev",
    "build": "n8n-node build",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "format": "prettier src --write",
    "release": "n8n-node release"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/src/credentials/avitoOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/src/nodes/Avito/Avito.node.js",
      "dist/src/nodes/Avito/AvitoMessengerTrigger.node.js"
    ],
    "strict": false
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.45.4",
    "eslint": "9.39.4",
    "n8n-workflow": "^2.16.0",
    "prettier": "3.9.6",
    "release-it": "20.0.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
